# --- Base de données (valeurs par défaut docker-compose) ---
DATABASE_URL=postgresql://smartshop:smartshop@db:5432/smartshop

# --- Telegram : créer un bot avec @BotFather et coller le token ici ---
TELEGRAM_BOT_TOKEN=
# chat_id du commerçant pour recevoir les alertes d'escalade (optionnel)
TELEGRAM_COMMERCANT_CHAT_ID=

# --- LLM : créer une clé gratuite sur console.groq.com ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# Groq a retiré les Llama 3.x : utiliser un modèle actuel qui gère le function-calling
LLM_MODEL=openai/gpt-oss-120b
# Transcription des messages vocaux (Groq Whisper)
LLM_TRANSCRIPTION_MODEL=whisper-large-v3

# --- WhatsApp Cloud API (optionnel : laisser vide pour désactiver le canal) ---
# Depuis Meta for Developers → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Chaîne que TU inventes ; à recopier à l'identique dans la config webhook Meta
WHATSAPP_VERIFY_TOKEN=

# --- Sécurité ---
JWT_SECRET=genere-une-longue-chaine-aleatoire-ici
